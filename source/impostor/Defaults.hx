package impostor;

/**
 * Default configuration values for the game.
 */
final class Defaults
{
	/** Default BPM used when no specific BPM is set */
	public static final DEFAULT_BPM:Float = 100.0;

	/** Default steps per beat for rhythm calculations */
	public static final DEFAULT_STEPS_PER_BEAT:Int = 4;

	/** Default beats per measure for rhythm calculations */
	public static final DEFAULT_BEATS_PER_MEASURE:Int = 4;
}